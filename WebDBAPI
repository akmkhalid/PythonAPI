from fastapi import FastAPI, Request, Form, HTTPException
from fastapi.responses import HTMLResponse, RedirectResponse
from fastapi.staticfiles import StaticFiles
from fastapi.templating import Jinja2Templates
import pyodbc
import os
from pathlib import Path

# Create required directories if they don't exist
os.makedirs("static", exist_ok=True)
os.makedirs("templates", exist_ok=True)

app = FastAPI()

# Mount static files and templates
app.mount("/static", StaticFiles(directory="static"), name="static")
templates = Jinja2Templates(directory="templates")

# Database configuration (using Windows Authentication)
server = os.getenv("DB_SERVER", r'KHALID\SQLEXPRESS')
database = 'CustomerManagement'
driver = '{ODBC Driver 17 for SQL Server}'
conn_str = f'DRIVER={driver};SERVER={server};DATABASE={database};Trusted_Connection=yes;'

@app.get("/", response_class=HTMLResponse)
async def read_root(request: Request):
    # Create basic form.html if it doesn't exist
    form_path = Path("templates/form.html")
    if not form_path.exists():
        form_path.write_text("""
        <!DOCTYPE html>
        <html>
        <head>
            <title>Customer Registration</title>
            <style>
                body { font-family: Arial, sans-serif; margin: 40px; }
                form { max-width: 500px; }
                label { display: block; margin: 10px 0; }
                input { width: 100%; padding: 8px; }
                button { padding: 10px 15px; margin-top: 10px; }
                .error { color: red; }    
            </style>
        </head>
        <body>
            <h1>Customer Registration</h1>
            {% if error %}
                <p class="error">{{ error }}</p>
            {% endif %}
		<form method="post" action="/">
                <label>First Name: <input type="text" name="FirstName" required></label>
                <label>Last Name: <input type="text" name="LastName" required></label>
                <label>Home Address: <input type="text" name="HomeAddress"></label>
                <label>Office Address: <input type="text" name="OfficeAddress"></label>
                <label>Phone: <input type="text" name="phone"></label>
                <label>Email: <input type="text" name="email"></label>
                <button type="submit">Submit</button>
            </form>
        </body>
        </html>
        """)
    return templates.TemplateResponse("form.html", {"request": request})

@app.post("/submit/")
async def submit_customer(
    request: Request,
    FirstName: str = Form(...),
    LastName: str = Form(...),
    HomeAddress: str = Form(""),
    OfficeAddress: str = Form(""),
    phone: str = Form(""),
    email: str = Form("")
):
    try:
        conn = pyodbc.connect(conn_str)
        cursor = conn.cursor()
        print("Database connection successful")

        sql_query="""
            INSERT INTO Customer 
            (FirstName, LastName, HomeAddress, OfficeAddress, Phone, Email)
            VALUES (?, ?, ?, ?, ?, ?)
            """
        values=(
                FirstName,
                LastName,
                HomeAddress if HomeAddress else None,
                OfficeAddress if OfficeAddress else None,
                phone if phone else None, 
                email if email else None
            )
        print(f"Executing SQL: {sql_query} with values: {values}")
        cursor.execute(sql_query, values)
        conn.commit()
        print("Data committed successfully")
        return RedirectResponse(url="/success", status_code=303)
        
    except pyodbc.Error as e:
        sqlstate = e.args[0] if e.args else "N/A"
        error_message = f"Database error: {sqlstate} - {e}"
        print(f"Database error occurred: {error_message}")
        return templates.TemplateResponse(
            "form.html",
            context={"request": request, "error": f"Database error: {str(e)}"},
            status_code=400)
    except Exception as e:
        error_message = f"An unexpected error occurred: {str(e)}"
        print(f"Unexpected error: {error_message}")
        return templates.TemplateResponse(
            "form.html",
            context={"request": request, "error": f"An unexpected error occurred: {str(e)}"},
            status_code=500)
    finally:
        if 'conn' in locals():
            conn.close()
        print("Database connection closed")

@app.get("/success")
async def success(request: Request):
    return HTMLResponse("""
    <html>
    <head><title>Success</title></head>
    <body style="font-family: Arial, sans-serif; margin: 40px;">
        <h1 style="color: green;">Success!</h1>
        <p>Customer registered successfully</p>
        <a href="/">Back to form</a>
    </body>
    </html>
    """)

def run_app():
    import uvicorn
    uvicorn.run("main:app", host="0.0.0.0", port=8000, reload=True)

if __name__ == "__main__":
    run_app()
