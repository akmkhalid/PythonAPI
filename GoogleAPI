import httpx
from fastapi import FastAPI

GOOGLE_CLIENT_ID = "not real-Id apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET = "not real secret GOCSPX-FxUVzAmpDA7B"
REDIRECT_URI = "http://localhost:8000/oauth2callback"
app = FastAPI()
@app.get("/authorize")
def authorize():
    return {
        "url": f"https://accounts.google.com/o/oauth2/auth?client_id={GOOGLE_CLIENT_ID}&redirect_uri={REDIRECT_URI}&scope=https://www.googleapis.com/auth/fitness.activity.read&response_type=code"
    }

@app.get("/oauth2callback")
async def oauth2callback(code: str):
    async with httpx.AsyncClient() as client:
        response = await client.post("https://oauth2.googleapis.com/token", data={
            "code": code,
            "client_id": GOOGLE_CLIENT_ID,
            "client_secret": GOOGLE_CLIENT_SECRET,
            "redirect_uri": REDIRECT_URI,
            "grant_type": "authorization_code"
        })
        tokens = response.json()
        access_token = tokens["access_token"]
        return {"access_token": access_token}
